# Database
DATABASE_URL=mysql+aiomysql://db_user:db_password@db-host:3306/db_name

# Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# App
APP_ROOT_PATH=/mapper-new
PORT=2528

# Public base URL of this mapper. A mapping may register its internal API as a
# bare path (e.g. /ref_crp_beneficiary); that path is expanded against this base
# when the mapped payload is delivered. Add a path prefix if the internal APIs
# are served under one. Leave unset to keep requiring absolute internal URLs.
MAPPER_BASE_URL=https://your-api-host.example.com:9001

# Auth service
AUTH_BASE_URL="https://your-api-host.example.com:9001/auth"
UPSTREAM_AUTH_URL=https://your-api-host.example.com:9001/auth/auth1/login
UPSTREAM_AUTH_EMAIL=admin@example.com
UPSTREAM_AUTH_PASSWORD=change-me
UPSTREAM_AUTH_DECRYPTION_KEY="change-me"
# Optional per-host auth services, for environments where the destination runs
# its own login endpoint. Applies to both cron delivery and scheduled jobs.
# Format: host=login_url[,host=login_url]
# UPSTREAM_AUTH_HOSTS=uat1.example.com=https://uat1.example.com/auth/auth1/login
# Optional. The AES key used to encrypt/decrypt central auth payloads; when it
# is unset the service falls back to UPSTREAM_AUTH_DECRYPTION_KEY. Accepts a
# 32-byte value directly, as base64, or as hex.
# AUTH_SERVICE_ENCRYPTION_KEY="change-me"

# The central auth service is external, so a single dropped connection or a
# brief 5xx must not surface to the caller as a hard failure. These are retried
# (never a 4xx - a rejected credential or a rate limit will not change), and a
# validated token's identity is cached briefly so console polling does not
# re-validate against the central service on every request. Set the cache to 0
# to disable it.
AUTH_RETRY_ATTEMPTS=3
AUTH_RETRY_BACKOFF_SECONDS=0.25
AUTH_TOKEN_CACHE_SECONDS=30

# Upstream API tokens (format: domain=token, comma-separated for multiple)
UPSTREAM_API_TOKENS=example.com=your-token-here

# Audit detail store (MongoDB) -- REQUIRED, no built-in default.
# The legacy gateway writes a full-detail document per call; the log views read
# it to fill in headers, the query string and the captured log. The service
# refuses to start if any of the three is missing, rather than falling back to
# a host that would leave the detail blocks silently empty.
AUDIT_MONGO_ENABLED=true
AUDIT_MONGO_URI=mongodb://mongo-host.example.com:27017/
AUDIT_MONGO_DATABASE=gateway_logs_db
AUDIT_MONGO_COLLECTION=api_gateway_logs
# Leave unset for automatic: the service only mirrors its own calls to MongoDB
# when api_call_log is missing the header columns (e.g. a MySQL account that
# cannot ALTER TABLE). Set true/false to force the choice either way.
# AUDIT_MONGO_MIRROR=true

# Optional shared secret for the external log-ingest API
# (POST /api/call-logs/ingest and POST /api/call-logs). When set, callers must
# send it in the X-Log-Ingest-Token header (or as "Authorization: Bearer <token>").
# When unset the endpoint accepts any caller (payloads are always redacted and
# the global rate limit still applies).
# LOG_INGEST_TOKEN=change-me

# Bank Alfalah console (sidebar -> Bank APIs).
# INTEGRATION_API_BASE_URL is the root of the IMIS integration service that
# fronts /integration/imis/api/compliance/* (tokenGeneration, bank-auth, the
# account-opening endpoints and the C2C endpoints).
INTEGRATION_API_BASE_URL=https://api.imis.com.pk:9001
#
# Authentication: there is no static token to configure. The console forwards
# the signed-in user's central auth bearer (the one issued by
# AUTH_BASE_URL/auth1/login at login) straight to the integration service,
# which validates the same bearer. Re-authenticate to refresh it.
BANK_API_TIMEOUT_SECONDS=60
